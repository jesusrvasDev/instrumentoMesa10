extends ../layout/index

block contenido 
    .py-10
        h1.text-4xl.my-10.font-extrabold.text-center Bienes
            span.font-normal Raices 
        h2.text-center.text-6xl.font-extrabold=pagina
        
    .mt-8.mx-auto.max-w-md
        div.bg-grey.py-8.px-4.shadow
            form.space-y-5
                div
                    label.block.text-sm.uppercase.text-gray-700.mb-2.font-bold(for="email") Tu correo
                    input#email.w-full.px-3.py-2.border.border-gray-300.rounted-md.placeholder-gray-400(placeholder="Tu email" type="email" name="email")
                .flex.items-center.justify-between
                    a.text-grey-500.text-xs(href="/auth/register") No tienes una cuenta? Crea una
                    a.text-grey-500.text-xs(href="/auth/login") Inicia sesión 
                input(class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold cursor-pointer py-3"  type="submit" value="Inciar sesión") 